   "duracion": 41.9,
   "archivo": "ig-18513335959097350.mp4",
   "frases": [
    {
     "inicio": 0.3,
     "fin": 5.62,
     "texto": "Quiero felicitar a toda la Corporación Municipal, al Equipo de Gobierno del Ayuntamiento de Madrid"
    },
    {
     "inicio": 5.62,
     "fin": 10.44,
     "texto": "y muy especialmente al Alcalde de Almeida, por este gran trabajo que han realizado en la"
    },
    {
     "inicio": 10.44,
     "fin": 15.26,
     "texto": "Plaza de la Independencia alrededor de la puerta de Alcalá, y que los madreños podamos"
    },
    {
     "inicio": 15.26,
     "fin": 20.22,
     "texto": "otra vez atravesarla andando como hace mucho tiempo que no se podía."
    },
    {
     "inicio": 20.7,
     "fin": 25.96,
     "texto": "Esto le daba a todo el entorno una belleza extraordinaria y hoy está todo lleno de"
    },
    {
     "inicio": 25.96,
     "fin": 29.24,
     "texto": "personas que han querido acercarse a mirarlo, a verlo, a contemplarlo, a disfrutarlo,"
    },
    {
     "inicio": 29.24,
     "fin": 34.24,
     "texto": "así que después de tanto sacrificio y obras se demuestra que cuando están bien empleadas"
    },
    {
     "inicio": 34.24,
     "fin": 39.86,
     "texto": "siempre son buenas, así que gracias de parte de todos los madreños y enhorabuena."
    }
   ],
