     "inicio": 0,
     "fin": 1.06,
     "texto": "¿Quién le pago a las primarias?"
    },
    {
     "inicio": 3.59,
     "fin": 4.63,
     "texto": "No me contesto."
    },
    {
     "inicio": 4.95,
     "fin": 7.67,
     "texto": "¿Abañó usted votos en las primarias de su partido o no?"
    },
