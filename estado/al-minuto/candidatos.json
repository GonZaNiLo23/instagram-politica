   "frases": [
    {
     "inicio": 0,
     "fin": 5.64,
     "texto": "Me preguntan por mi opinión sobre la reapertura de un centro de ilegales"
    },
    {
     "inicio": 5.64,
     "fin": 10.16,
     "texto": "para alojar a 1.600 personas en la laguna que cuesta 23 millones de euros."
    },
    {
     "inicio": 10.64,
     "fin": 13.32,
     "texto": "23 millones de euros que tenían que ir a los españoles."
    },
    {
     "inicio": 13.46,
     "fin": 18.36,
     "texto": "Precisamente el Gobierno de Extremadura, en el que Vox participa,"
    },
    {
     "inicio": 18.76,
     "fin": 21.9,
     "texto": "acaba de decidir que 11 millones de ayuda al exterior"
    },
    {
     "inicio": 21.9,
     "fin": 25.88,
     "texto": "no pueden ir a ayudar a los de fuera cuando los extremeños lo están pasando mal"
    },
    {
     "inicio": 25.88,
     "fin": 29.82,
     "texto": "y esos 11 millones se han destinado a la sanidad de los extremeños."
    },
    {
     "inicio": 30,
     "fin": 32.4,
     "texto": "En primer lugar, tenemos que ayudar a los de casa"
    },
    {
     "inicio": 32.4,
     "fin": 36.46,
     "texto": "y cuando algún día estemos bien, que no parece algo muy cercano,"
    },
    {
     "inicio": 37.34,
     "fin": 40.08,
     "texto": "evidentemente, todas las cuestiones relativas a la ayuda exterior"
    },
    {
     "inicio": 40.08,
     "fin": 41.7,
     "texto": "se podrán plantear, pero en este momento"
    },
    {
     "inicio": 41.7,
     "fin": 44.66,
     "texto": "yo creo que es una auténtica traición a los españoles."
