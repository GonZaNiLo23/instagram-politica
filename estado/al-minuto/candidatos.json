   "frases": [
    {
     "inicio": 0,
     "fin": 2.52,
     "texto": "Quieren hacerte creer que da igual quien gobierne este país."
    },
    {
     "inicio": 4.02,
     "fin": 7.46,
     "texto": "Teresa conservó su llave y encontró nuevos vecinos."
    },
    {
     "inicio": 9.06,
     "fin": 10.68,
     "texto": "Clara necesitaba gafas."
    },
    {
     "inicio": 11.08,
     "fin": 15.58,
     "texto": "Y su padre pudo comprárselas sin tener que hacer un gran sacrificio."
    },
    {
     "inicio": 17.5,
     "fin": 20.56,
     "texto": "Carlos y Lucía abrieron la puerta de su propia casa."
    },
    {
     "inicio": 22.64,
     "fin": 25.86,
     "texto": "Y Manuela finalmente tuvo tiempo de leer su libro."
    },
    {
     "inicio": 25.86,
     "fin": 29.6,
     "texto": "Pero a ellos y a ellas sí que les importa."
    },
    {
     "inicio": 30.22,
     "fin": 33.22,
     "texto": "Así que cuando te digan que da igual quien gobierne este país,"
    },
    {
     "inicio": 33.88,
     "fin": 37.64,
     "texto": "ya sabes lo que diría Clara y Teresa y Carlos y Lucía."
    },
    {
     "inicio": 38.6,
     "fin": 42.12,
     "texto": "Y Manuela, este 29 de noviembre es el momento."
    },
    {
     "inicio": 42.98,
     "fin": 43.84,
     "texto": "Pregúntatelo tú también."
    }
