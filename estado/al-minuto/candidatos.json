   "frases": [
    {
     "inicio": 6.9,
     "fin": 9.44,
     "texto": "Presidente. Yo mi pueblo no lo abandono. Yo no lo abandono."
    },
    {
     "inicio": 9.66,
     "fin": 11.86,
     "texto": "Viví la educación, viví la sabidad, viví las carencias."
    },
    {
     "inicio": 12.42,
     "fin": 15.9,
     "texto": "Más de volto a la esperanza. Así que, a por ello."
    },
    {
     "inicio": 19.72,
     "fin": 22.26,
     "texto": "No sé cuántos años pero estarás con nosotros."
    },
    {
     "inicio": 22.86,
     "fin": 24.58,
     "texto": "Todos unidos. Confiamos en ti."
    },
    {
     "inicio": 25.92,
     "fin": 27.16,
     "texto": "Pero muchas gracias por lo que estás haciendo."
    },
    {
     "inicio": 29.32,
     "fin": 32.8,
     "texto": "Nosotras somos funcionales y estamos apoyándote, maestras."
    },
    {
     "inicio": 33.12,
     "fin": 34.28,
     "texto": "Con el futuro en la mar."
    },
    {
     "inicio": 34.28,
     "fin": 35.22,
     "texto": "Tenemos esperanza."
    },
    {
     "inicio": 35.24,
     "fin": 37.32,
     "texto": "Sí, no está chiqui, cante nadie."
    },
    {
     "inicio": 37.6,
     "fin": 40.58,
     "texto": "Con esa empatía. No cargar con esa violencia."
    },
    {
     "inicio": 40.76,
     "fin": 41.78,
     "texto": "Eso no lo se lo escuchan a nadie."
    },
    {
     "inicio": 41.8,
     "fin": 43.68,
     "texto": "El negocio de los partidos es dividirnos."
    },
    {
     "inicio": 43.88,
     "fin": 47.56,
     "texto": "Cuando tú eres un partido que dice públicamente"
    },
    {
     "inicio": 47.56,
     "fin": 50.4,
     "texto": "que cuando nosotros se van a cavar las subvenciones"
    },
    {
     "inicio": 50.4,
     "fin": 53.18,
     "texto": "a sindicatos, medios y partidos políticos,"
    },
    {
     "inicio": 53.64,
     "fin": 54.44,
