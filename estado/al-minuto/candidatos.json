     "fin": 8.09,
     "texto": "¿No?"
    },
    {
     "inicio": 8.39,
     "fin": 10.17,
     "texto": "¿Dónde salió el dinero de la campaña?"
    },
    {
     "inicio": 10.27,
     "fin": 12.57,
     "texto": "¿Usted recibió alguna donación proveniente de la prostitución?"
    },
    {
     "inicio": 13.09,
     "fin": 15.53,
     "texto": "¿Pero metió a hacer público los donantes de su partido?"
    },
    {
     "inicio": 15.99,
     "fin": 16.75,
     "texto": "¿Y por qué no lo hace?"
    },
    {
     "inicio": 17.01,
     "fin": 18.59,
     "texto": "¿Por qué la justicia está teniendo…?"
    },
    {
     "inicio": 19.03,
     "fin": 20.81,
     "texto": "Ah, están manos de la justicia, usted lo ha dicho."
    },
    {
     "inicio": 20.99,
     "fin": 24.55,
     "texto": "¿A usted le está investigando los juzgados de Madrid,"
    },
    {
     "inicio": 25.07,
     "fin": 28.15,
     "texto": "de Badajoz, de Tenerife, de Teruel,"
    },
    {
     "inicio": 28.15,
     "fin": 32.19,
     "texto": "de la Fiscalía Europea, la Audiencia Nacional y el Tribunal Supremo?"
    },
    {
     "inicio": 32.33,
     "fin": 35.37,
     "texto": "¿Cree usted que todo esto incluye la Fiscalía Europea de Slobúfer?"
    },
    {
     "inicio": 35.65,
     "fin": 37.15,
     "texto": "No, no, no es una conspiración."
    },
    {
     "inicio": 37.37,
     "fin": 39.45,
     "texto": "Es que ustedes han delinquido mucho, señor Sánchez."
