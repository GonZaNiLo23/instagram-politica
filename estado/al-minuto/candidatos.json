   "frases": [
    {
     "inicio": 0,
     "fin": 5.18,
     "texto": "Son las elecciones anormales, porque deberían ser unas elecciones democráticas más,"
    },
    {
     "inicio": 5.54,
     "fin": 11.64,
     "texto": "en las que estuviese el juego la alternancia política, pero está en juego la supervivencia de España como nación democrática."
    },
    {
     "inicio": 11.84,
     "fin": 14.78,
     "texto": "Están en juego nuestra misma existencia como pueblo libre."
    },
    {
     "inicio": 15,
     "fin": 19.24,
     "texto": "Están en juego nuestra dignidad, están en juego la unidad y la integridad de la patria,"
    },
    {
     "inicio": 19.32,
     "fin": 25.14,
     "texto": "porque se presenta un tipo que ya ha entregado todo hasta ahora a los enemigos de España en el interior y en el exterior."
    },
    {
     "inicio": 25.14,
     "fin": 27.18,
     "texto": "Todo está en juego en estas elecciones."
    },
    {
     "inicio": 27.66,
     "fin": 32.02,
     "texto": "Están en juego la prosperidad de los autónomos de las pibes y de las familias y de los trabajadores."
    },
    {
     "inicio": 32.2,
     "fin": 35.8,
     "texto": "Están en juego la libertad de las mujeres y de los mayores en las calles."
    },
    {
     "inicio": 36,
     "fin": 40.08,
     "texto": "Están en juego el futuro de los jóvenes que tienen que migrar, que no pueden acceder a una vivienda,"
    },
    {
     "inicio": 40.36,
     "fin": 44.94,
     "texto": "que no pueden formar una familia, porque no tienen salarios de centes después de años de formación."
    },
    {
     "inicio": 45.14,
     "fin": 48.72,
     "texto": "Todo está en juego y los culpables se presentan a las elecciones."
    }
