   "frases": [
    {
     "inicio": 0.37,
     "fin": 14,
     "texto": "Estamos aquí hablando para manifestar nuestro luto, para manifestar nuestra rabia,"
    },
    {
     "inicio": 14.12,
     "fin": 20.96,
     "texto": "para manifestar nuestro recuerdo emocionado y para manifestar nuestra solidaridad"
    },
    {
     "inicio": 20.96,
     "fin": 27.74,
     "texto": "con las familias de esos españoles que se han ido tan injustamente hace muy pocas horas."
    },
    {
     "inicio": 28.88,
     "fin": 35.72,
     "texto": "Estamos aquí también y eso es quizá más importante que simplemente mostrar buenos sentimientos"
    },
    {
     "inicio": 35.72,
     "fin": 43.72,
     "texto": "para mostrar y anunciar nuestro compromiso absoluto de no descansar"
    },
    {
     "inicio": 43.72,
     "fin": 48.64,
     "texto": "hasta que los españoles se sientan seguros en su propia patria,"
    },
    {
     "inicio": 48.82,
     "fin": 53.5,
     "texto": "hasta que los españoles se sientan seguros para volver a montar en el tren,"
    },
    {
     "inicio": 53.5,
     "fin": 57.22,
     "texto": "hasta que los españoles se sientan protegidos por sus instituciones."
    },
    {
     "inicio": 57.82,
     "fin": 62.3,
     "texto": "Y estamos aquí también para manifestar nuestro compromiso absoluto de no parar"
    },
    {
     "inicio": 63.22,
     "fin": 69.7,
     "texto": "y de no detenernos hasta que se depuren responsabilidades y hasta que se haga justicia."
    },
    {
     "inicio": 79.71,
     "fin": 83.25,
     "texto": "Son 74 españoles muertos por ahora, pero no son 74."
    },
    {
     "inicio": 84.35,
     "fin": 87.79,
     "texto": "Son ya 120 en un año en accidentes ferroviarios."
    },
    {
     "inicio": 89.42,
     "fin": 95.08,
     "texto": "¿Por qué no ha dimitido aún el ministro de transporte"
    },
    {
     "inicio": 95.08,
