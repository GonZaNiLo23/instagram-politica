    {
     "inicio": 0,
     "fin": 4.56,
     "texto": "¿Ustedes dicen que van a expulsar a 8 millones de migrantes en este país y a sus hijos?"
    },
    {
     "inicio": 5.3,
     "fin": 6.3,
     "texto": "También la mía mal, ¿no?"
    },
    {
     "inicio": 7.74,
     "fin": 9.26,
     "texto": "También Nico Williams, ¿no?"
    },
    {
     "inicio": 9.84,
     "fin": 10.24,
     "texto": "No creo."
    },
    {
     "inicio": 11.2,
     "fin": 17.84,
     "texto": "Más allá de la broma, me tienen despistado porque no nos quieren a los indepes, porque"
    },
    {
     "inicio": 17.84,
     "fin": 23.12,
     "texto": "no queremos ser españoles, tampoco quieren a los migrantes porque quieren ser españoles,"
    },
    {
     "inicio": 23.78,
     "fin": 24.86,
     "texto": "entonces ¿ustedes a quiénes quieren?"
    },
    {
     "inicio": 25.9,
     "fin": 26.58,
     "texto": "No quieren a nadie."
    },
    {
     "inicio": 26.58,
     "fin": 31.98,
     "texto": "Pero les voy a decir algo, ustedes no van a expulsar a nadie, a nadie, y mucho menos"
    },
    {
     "inicio": 31.98,
     "fin": 36.56,
     "texto": "a 8 millones de personas, primero porque si expusa a tanta gente al final va a tener que trabajar"
    },
    {
     "inicio": 36.56,
     "fin": 37.16,
     "texto": "hasta Bascal."
    },
    {
     "inicio": 39.11,
     "fin": 47.88,
     "texto": "Y segundo, y segundo, y segundo, porque ustedes no representan a sus migrantes,"
    },
    {
     "inicio": 48.32,
     "fin": 50.78,
     "texto": "ustedes representan a los empresarios que les explotan."
    }
