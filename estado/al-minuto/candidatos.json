   "frases": [
    {
     "inicio": 0,
     "fin": 1.06,
     "texto": "¿Usted se cree en las encuestas?"
    },
    {
     "inicio": 1.76,
     "fin": 6.22,
     "texto": "Yo siempre he desconfiado de las encuestas, pero soy sociólogo."
    },
    {
     "inicio": 6.84,
     "fin": 10.34,
     "texto": "Yo creo que las encuestas pueden acertar."
    },
    {
     "inicio": 10.96,
     "fin": 16.08,
     "texto": "También creo que hay veces que es difícil medir el sentimiento de un pueblo,"
    },
    {
     "inicio": 16.18,
     "fin": 20.1,
     "texto": "especialmente cuando suceden cosas muy graves y permanentemente,"
    },
    {
     "inicio": 20.48,
     "fin": 22.98,
     "texto": "y hay veces también que se publican encuestas manipuladas."
    },
    {
     "inicio": 23.2,
     "fin": 25.6,
     "texto": "Yo estos días estoy cochando por ahí a mucho un guru"
    },
    {
     "inicio": 26.54,
     "fin": 28.78,
     "texto": "contando unos disparates que..."
    },
    {
     "inicio": 28.78,
     "fin": 29.34,
     "texto": "¿Algún lo que crees?"
    },
    {
     "inicio": 29.86,
     "fin": 32.32,
     "texto": "Ningún, que tenga demasiado importancia para mí."
    },
    {
     "inicio": 32.76,
     "fin": 34.54,
     "texto": "Pero estoy escuchando, no a uno,"
    },
    {
     "inicio": 34.8,
     "fin": 39.32,
     "texto": "a más de uno haciendo unas afirmaciones que resultan sorprendentes."
    },
    {
     "inicio": 39.54,
     "fin": 42.9,
     "texto": "En todo caso, yo creo que lo importante de la pregunta, si me lo permite,"
    },
    {
     "inicio": 43.92,
     "fin": 48.62,
     "texto": "es que desde el 23 hasta ahora hay una coincidencia en casi todas las encuestas"
    },
    {
     "inicio": 48.62,
     "fin": 52.44,
     "texto": "y es que Vox es el único de los grandes partidos que crece,"
    },
    {
     "inicio": 52.68,
     "fin": 54.78,
     "texto": "y que crece mucho."
    },
    {
     "inicio": 54.78,
     "fin": 58.32,
     "texto": "Y digo esto porque hay quienes están diciendo que Sánchez tiene interés"
    },
    {
     "inicio": 58.32,
     "fin": 59.26,
     "texto": "en que Vox crezca."
    },
    {
     "inicio": 59.9,
     "fin": 62.64,
     "texto": "Me parece muy llamativo, porque el crecimiento de Vox"
    },
    {
     "inicio": 63.38,
     "fin": 66.58,
     "texto": "es lo único que está asegurando en estos momentos"
    },
    {
     "inicio": 66.58,
     "fin": 67.72,
     "texto": "que haya una alternativa."
    },
    {
     "inicio": 68.02,
     "fin": 70.2,
     "texto": "Las encuestas parece que coinciden también"
    },
    {
     "inicio": 70.2,
     "fin": 74.2,
     "texto": "en que el Partido Popular mantiene sus posiciones modestas del año 23"
    },
    {
     "inicio": 74.2,
     "fin": 78.42,
     "texto": "e incluso que podría bajar un poco el Partido Socialista a baja,"
    },
    {
     "inicio": 79.24,
     "fin": 82.32,
     "texto": "el frente estrecho se estrecha"
    },
    {
     "inicio": 82.32,
     "fin": 85.98,
     "texto": "y no me extraña con su mirada torba y derracibilista."
    },
    {
     "inicio": 86.82,
     "fin": 89.54,
     "texto": "Y, sin embargo, parece que Vox puede crecer mucho"
    },
    {
     "inicio": 89.54,
     "fin": 91.66,
     "texto": "y que eso asegura la alternativa en España."
    },
    {
     "inicio": 92.44,
     "fin": 94.18,
     "texto": "Por lo tanto, no creo que Sánchez tenga mucho interés"
    },
    {
     "inicio": 94.18,
     "fin": 96.32,
     "texto": "en engordar a Vox francamente."
    }
   ],
