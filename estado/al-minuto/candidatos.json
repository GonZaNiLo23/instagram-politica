    {
     "inicio": 0,
     "fin": 4.44,
     "texto": "Nosotros estamos hoy aquí precisamente, no para hacer política, como están diciendo algunos."
    },
    {
     "inicio": 4.62,
     "fin": 10.64,
     "texto": "Estamos para hacer justicia, para no callar jamás, para no admitir que nos silencien"
    },
    {
     "inicio": 10.64,
     "fin": 15.78,
     "texto": "y para decir que vamos a dejarnos la piel para que esto jamás vuelva a ocurrir en España."
    },
    {
     "inicio": 17.56,
     "fin": 23.06,
     "texto": "Nos dicen que tenemos que callar por este accidente, que el luto significa silencio"
    },
    {
     "inicio": 23.06,
     "fin": 25.58,
     "texto": "y nos están hablando de la guerra civil de hace un siglo."
    },
    {
     "inicio": 25.9,
     "fin": 29.14,
     "texto": "Nos dicen que tenemos que callar y que el luto implica silencio."
    },
    {
     "inicio": 29.14,
     "fin": 33.4,
     "texto": "Pero los mismos que montaron la que montaron por un perro que se llamaba Scalibur"
    },
    {
     "inicio": 33.4,
     "fin": 38.14,
     "texto": "o el amigote de Óscar Muerte que ha puesto en Renfe que montó un lío porque había muerto un pato,"
    },
    {
     "inicio": 38.16,
     "fin": 41.86,
     "texto": "un pato en el Manzanares, politizó eso y nos dicen que tenemos que callar"
    },
    {
     "inicio": 41.86,
     "fin": 47.48,
     "texto": "ante 74 españoles que han muerto jamás, jamás."
    }
