   "texto": "Quieren hacerte creer que da igual quién gobierne este país.\n\nPero no da igual. \nPregúntale a Teresa.\n\n#LaFuerzaDeLaGente\n#VotaPSOE",
   "credito": "Vídeo: @sanchezcastejon",
   "duracion": 134.3,
   "archivo": "ig-18065645564716628.mp4",
   "frases": [
    {
     "inicio": 0,
     "fin": 1.66,
     "texto": "¡Madre mía! ¡Madre mía!"
    },
    {
     "inicio": 1.8,
     "fin": 4.02,
     "texto": "¡Más que con este día tan asqueroso!"
    },
    {
     "inicio": 4.3,
     "fin": 7.2,
     "texto": "¿Quieren hacerte creer que da igual que en gobiernes de país?"
    },
    {
     "inicio": 7.84,
     "fin": 9.04,
     "texto": "Pero Teresa sí que le importa."
    },
    {
     "inicio": 9.54,
     "fin": 14.18,
     "texto": "Cada semana Ana, su vecina de abajo, le sube la compra."
    },
    {
     "inicio": 14.62,
     "fin": 15.84,
     "texto": "¡Un mando!"
    },
    {
     "inicio": 16.3,
     "fin": 20.06,
     "texto": "Teresa lleva casi 40 años abriendo esta puerta con la misma llave."
    },
    {
     "inicio": 21.6,
     "fin": 23.22,
     "texto": "Aquí crió a su familia."
    },
    {
     "inicio": 24.28,
     "fin": 27.38,
     "texto": "No se ha retrasado ni una sola vez en el pago del alquiler."
    },
    {
     "inicio": 28.38,
     "fin": 32.1,
     "texto": "Hasta que un día vendieron su edificio a un fondo de inmersión."
    },
    {
     "inicio": 33.04,
     "fin": 35.42,
     "texto": "Teresa ni siquiera sabía que era un fondo,"
    },
    {
     "inicio": 35.58,
     "fin": 36.78,
     "texto": "hasta que llegó la carta."
    },
    {
     "inicio": 37.84,
     "fin": 40.72,
     "texto": "La carta no empezaba con estimada Teresa como siempre."
    },
    {
     "inicio": 41.44,
     "fin": 43.2,
     "texto": "Decía, estimado en Quilino."
    },
    {
     "inicio": 43.8,
     "fin": 46.98,
     "texto": "Y les anunciaba que cuando en unos meses venciera su contrato,"
    },
    {
     "inicio": 47.64,
     "fin": 50.2,
     "texto": "el alquiler subiría al doble."
    },
    {
     "inicio": 51.46,
     "fin": 52.98,
     "texto": "Ana recibió la misma carta,"
    },
    {
     "inicio": 53.68,
     "fin": 55.7,
     "texto": "pero su contrato vencía ese mismo mes."
    },
    {
     "inicio": 56.42,
     "fin": 59.46,
     "texto": "Ella no podía pagar el doble, así que se marchó."
    },
    {
     "inicio": 62.58,
     "fin": 64.9,
     "texto": "Pronto empezaron a subir desconocidos con maletas."
    },
    {
     "inicio": 65.7,
     "fin": 68.8,
     "texto": "La casa de Ana se había convertido en un piso turístico."
    },
    {
     "inicio": 70,
     "fin": 72.38,
     "texto": "Su contrato estaba a punto de vencer."
    },
    {
     "inicio": 73.32,
     "fin": 75.1,
     "texto": "Teresa pasaba las noches en vela,"
    },
    {
     "inicio": 75.64,
     "fin": 78.12,
     "texto": "preguntándose cómo iba a pagar el doble por una casa"
    },
    {
     "inicio": 78.12,
     "fin": 79.7,
     "texto": "que cada día sentía menos suya."
    },
    {
     "inicio": 80.54,
     "fin": 82.34,
     "texto": "Entonces dejaron de llegar las maletas"
    },
    {
     "inicio": 82.34,
     "fin": 85.16,
     "texto": "y el piso de abajo se quedó en silencio."
    },
    {
     "inicio": 85.16,
     "fin": 89.22,
     "texto": "Su gobierno regional está aplicando por fin la ley de vivienda"
    },
    {
     "inicio": 89.22,
     "fin": 92.24,
     "texto": "y los fondos no pueden expulsar a inquilinos como Teresa,"
    },
    {
     "inicio": 92.92,
     "fin": 93.96,
     "texto": "duplicándoles el alquiler."
    },
    {
     "inicio": 95.32,
     "fin": 97.8,
     "texto": "Además, los pisos turísticos ilegales"
    },
    {
     "inicio": 97.8,
     "fin": 99.64,
     "texto": "están siendo retirados del mercado."
    },
    {
     "inicio": 100.8,
     "fin": 104.42,
     "texto": "Cuando llegó la siguiente carta, Teresa tuvo miedo de abrirla."
    },
    {
     "inicio": 105.16,
     "fin": 108.62,
     "texto": "Esta vez, la carta empezaba con estimada Teresa."
    },
    {
     "inicio": 109.38,
     "fin": 110.76,
     "texto": "Su alquiler no iba a duplicarse."
    },
    {
     "inicio": 111.34,
     "fin": 113.06,
     "texto": "Su hogar estaba a salvo."
    },
    {
     "inicio": 115.52,
     "fin": 118.08,
     "texto": "Y el piso de abajo volvía a tener vecinos."
    },
    {
     "inicio": 118.28,
     "fin": 119.84,
     "texto": "Una pareja joven."
    },
    {
     "inicio": 121.84,
     "fin": 124.88,
     "texto": "Así que cuando te digan que da igual quien gobierne,"
    },
    {
     "inicio": 125.26,
     "fin": 125.8,
     "texto": "no da igual."
    },
    {
     "inicio": 126.52,
     "fin": 127.3,
     "texto": "Pregúntale a Teresa."
    }
   ],
