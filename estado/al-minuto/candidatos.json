   "frases": [
    {
     "inicio": 0,
     "fin": 7.93,
     "texto": "Es padres, es cargos, mi abuela."
    },
    {
     "inicio": 8.59,
     "fin": 9.43,
     "texto": "¿No es bonita mi mujer?"
    },
    {
     "inicio": 9.93,
     "fin": 10.41,
     "texto": "Es ella."
    },
    {
     "inicio": 10.77,
     "fin": 11.29,
     "texto": "¡Qué bonita!"
    },
    {
     "inicio": 13.85,
     "fin": 15.51,
     "texto": "También además de tiempo, tiempo de calidad."
    },
    {
     "inicio": 15.81,
     "fin": 17.63,
     "texto": "Siempre que tengo un huequito intento pasar la verdad."
    },
    {
     "inicio": 17.85,
     "fin": 20.71,
     "texto": "Hombre, si hay una desgracia, una muerte o algo de eso, claro,"
    },
    {
     "inicio": 21.01,
     "fin": 24.57,
     "texto": "que sería que tenga más día, más tiempo."
    },
    {
     "inicio": 24.81,
     "fin": 28.73,
     "texto": "Ponimos a hacer rescargos en los últimos años de mi padre,"
    },
    {
     "inicio": 28.91,
     "fin": 30.25,
     "texto": "que fue un poco durillo."
    },
    {
     "inicio": 33.65,
     "fin": 35.13,
     "texto": "Sí, sí, claro, eso es ideal."
    },
    {
     "inicio": 35.13,
     "fin": 37.39,
     "texto": "En nuestra época esto no existía,"
    },
    {
     "inicio": 37.83,
     "fin": 40.57,
     "texto": "y eran tres días para él,"
    },
    {
     "inicio": 40.97,
     "fin": 43.27,
     "texto": "y en mi caso eran tres meses, creo."
    },
    {
     "inicio": 43.47,
     "fin": 46.27,
     "texto": "Pues me parece genial poder compaginarlo"
    },
    {
     "inicio": 46.27,
     "fin": 48.31,
     "texto": "con su trabajo y con su carrera profesional."
    },
    {
     "inicio": 49.37,
     "fin": 51.55,
     "texto": "En esa sala izquierda, sobre todo gracias al pez,"
    },
    {
     "inicio": 51.61,
     "fin": 53.83,
     "texto": "hemos conseguido una serie de derechos"
    },
    {
     "inicio": 53.83,
     "fin": 55.91,
     "texto": "que nos ha costado muchísimo conseguir."
    },
    {
     "inicio": 56.01,
     "fin": 58.87,
     "texto": "Con un gobierno de derechas es súper fácil,"
    },
    {
     "inicio": 59.49,
     "fin": 59.93,
     "texto": "súper rápido,"
    },
    {
     "inicio": 60.05,
     "fin": 63.21,
     "texto": "perder todo lo que ha costado años y años"
    },
    {
     "inicio": 63.21,
     "fin": 64.45,
     "texto": "de lucha construir."
    },
    {
     "inicio": 64.57,
     "fin": 67.97,
     "texto": "Nos estamos jugando a avanzar o a retroceder,"
    },
    {
     "inicio": 68.17,
     "fin": 70.57,
     "texto": "y yo siempre, si puedo, el hijo es a avanzar."
    }
