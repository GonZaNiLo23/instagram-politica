   "frases": [
    {
     "inicio": 0,
     "fin": 2.4,
     "texto": "Yo le hice cinco preguntas al señor Sánchez hace unas semanas,"
    },
    {
     "inicio": 2.5,
     "fin": 4.66,
     "texto": "el vuelvo a reiterar, porque a lo mejor hoy me las contesta."
    },
    {
     "inicio": 5.06,
     "fin": 7.78,
     "texto": "Señor Sánchez, ¿por qué usted enseguía un sistema de seguridad"
    },
    {
     "inicio": 7.78,
     "fin": 10.66,
     "texto": "que tuvo 170 fallos en los dos últimos años?"
    },
    {
     "inicio": 11.36,
     "fin": 14.06,
     "texto": "¿Qué hizo usted después de la tragedia de Adamud"
    },
    {
     "inicio": 14.06,
     "fin": 15.26,
     "texto": "para evitar la de Toledo?"
    },
    {
     "inicio": 15.84,
     "fin": 18.48,
     "texto": "Oiga, ¿por qué no hizo casustera las incidencias"
    },
    {
     "inicio": 18.48,
     "fin": 21.08,
     "texto": "que los maquinistas apuntaban en los partes?"
    },
    {
     "inicio": 21.72,
     "fin": 24.14,
     "texto": "¿Y el vuelvo a reiterar? ¿Usted o Moncloa"
    },
    {
     "inicio": 24.14,
     "fin": 26.28,
     "texto": "filtró los audios del maquinista muerto?"
    }
   ],
