   "frases": [
    {
     "inicio": 0,
     "fin": 5.28,
     "texto": "Señor Sánchez, le subo a la posibilidad de presidir el gobierno de España."
    },
    {
     "inicio": 5.4,
     "fin": 10.24,
     "texto": "Es que no dice si el que no preside el gobierno de España asume usted la responsabilidad,"
    },
    {
     "inicio": 10.44,
     "fin": 15.32,
     "texto": "uno, de dimitir después de las elecciones, dos, de dejar el acta de diputado,"
    },
    {
     "inicio": 15.56,
     "fin": 19.56,
     "texto": "tres, de renunciar al aforamiento, renuncio usted, yo sí."
    },
    {
     "inicio": 20.42,
     "fin": 21.26,
     "texto": "Señor Fejo."
    },
    {
     "inicio": 21.78,
     "fin": 22.5,
     "texto": "Pues ya le he contestado."
    },
    {
     "inicio": 22.62,
     "fin": 23.38,
     "texto": "Le estoy preguntando."
    },
    {
     "inicio": 23.74,
     "fin": 26.08,
     "texto": "Señor Sánchez, le estoy preguntando si no, señor Fejo."
    },
    {
     "inicio": 26.4,
     "fin": 29.64,
     "texto": "Prueba de que lo reconozco que le estoy diciendo que o usted o yo vamos a presidir"
    },
    {
     "inicio": 29.64,
     "fin": 33.04,
     "texto": "el gobierno, usted va a dimitir y va a dejar el aforamiento o sí o no, yo sí."
    }
