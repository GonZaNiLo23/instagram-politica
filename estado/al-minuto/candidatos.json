   "archivo": "ig-17889655059486008.mp4",
   "frases": [
    {
     "inicio": 0,
     "fin": 5.38,
     "texto": "Los hospitales de España, los hospitales de los españoles, de los hospitales, de los trabajadores de nuestra patria"
    },
    {
     "inicio": 5.38,
     "fin": 6.84,
     "texto": "no son para el mundo entero."
    },
    {
     "inicio": 6.98,
     "fin": 13.18,
     "texto": "Es incompatible defender la invasión migratoria y decir que uno es defensor de los servicios públicos y de la sanidad pública."
    },
    {
     "inicio": 13.44,
     "fin": 14.74,
     "texto": "Es absolutamente incompatible."
    },
    {
     "inicio": 14.9,
     "fin": 18.3,
     "texto": "Desde que llegó Sánchez, las listas de espera han aumentado un 46%."
    },
    {
     "inicio": 18.3,
     "fin": 22.2,
     "texto": "Hay 4 millones de españoles, 4 millones de españoles en lista de espera."
    },
    {
     "inicio": 22.56,
     "fin": 26.44,
     "texto": "Y hay un récord de españoles con seguros privados de sanidad."
    },
    {
     "inicio": 26.88,
     "fin": 28.3,
     "texto": "Es decir, que pagan dos veces."
    },
    {
     "inicio": 28.58,
     "fin": 28.82,
     "texto": "¿Por qué?"
    },
    {
     "inicio": 29.3,
     "fin": 31.12,
     "texto": "Porque también se está colapsando la sanidad privada."
    },
    {
     "inicio": 31.2,
     "fin": 33.38,
     "texto": "Como consecuencia del colapso de la sanidad pública."
    },
    {
     "inicio": 33.46,
     "fin": 33.9,
     "texto": "¿Lo sabéis todos?"
    },
    {
     "inicio": 34.16,
     "fin": 35.38,
     "texto": "No hace falta que lo justifique mucho."
    },
    {
     "inicio": 35.46,
     "fin": 37.36,
     "texto": "No hace falta que ven aquí a decir unos números."
    },
    {
     "inicio": 37.68,
     "fin": 38.64,
     "texto": "Sánchez podrá decir otros."
    },
    {
     "inicio": 38.88,
     "fin": 40.24,
     "texto": "Ya sabéis que miente, que es un sinvergüenza."
    },
    {
     "inicio": 40.58,
     "fin": 42.76,
     "texto": "Cuando hablo, todos os estáis pensando en vuestros familiares."
    },
    {
     "inicio": 43,
     "fin": 47.8,
     "texto": "Todos sabéis lo que hay alrededor y lo que no había en España hace 10 o hace 20 años."
    },
    {
     "inicio": 48,
     "fin": 50.5,
     "texto": "Lo han destruido absolutamente todo."
    },
    {
     "inicio": 50.84,
     "fin": 56.38,
     "texto": "La asistencia sanitaria, la asistencia social, el mercado de la vivienda, la seguridad en las calles,"
    },
    {
     "inicio": 56.38,
     "fin": 60.78,
     "texto": "la unidad de la patria, la dignidad de nuestro país entregada y pisoteada en Ceuta"
    },
    {
     "inicio": 60.78,
     "fin": 62.18,
     "texto": "con una invasión intolerable."
    },
    {
     "inicio": 62.52,
     "fin": 64.68,
     "texto": "No ha habido nada que no hayan destruido."
    }
   ],
