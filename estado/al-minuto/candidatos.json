    },
    {
     "inicio": 82.72,
     "fin": 86.22,
     "texto": "No podemos soportar cuatro años más de Partido Socialista."
    },
    {
     "inicio": 86.38,
     "fin": 89.2,
     "texto": "Cuatro años más de Sánchez y del Partido Socialista"
