   "frases": [
    {
     "inicio": 0,
     "fin": 3.9,
     "texto": "El ministro Puente, en la comparecencia que tiene hoy en el Congreso de los Diputados,"
    },
    {
     "inicio": 4.52,
     "fin": 8.14,
     "texto": "debería, en primer lugar, pedir perdón, decir que se marcha a su casa"
    },
    {
     "inicio": 8.14,
     "fin": 10.22,
     "texto": "y que se va a poner a disposición judicial."
    },
    {
     "inicio": 10.66,
     "fin": 13.94,
     "texto": "Todo lo que puede explicar hoy el ministro Puente o el Partido Socialista,"
    },
    {
     "inicio": 14.1,
     "fin": 18.28,
     "texto": "sea el presidente del Gobierno o cualquier portavoz del Partido Socialista,"
    },
    {
     "inicio": 18.6,
     "fin": 20.96,
     "texto": "es insultar al conjunto de los españoles"
    },
    {
     "inicio": 21.47,
     "fin": 25.06,
     "texto": "y pisotear la memoria de las víctimas de Urda o Adamuz."
    },
    {
     "inicio": 25.8,
     "fin": 30.94,
     "texto": "No queremos las migajas en forma de decretos y millones de euros del Partido Socialista."
    },
    {
     "inicio": 31.28,
     "fin": 35,
     "texto": "Lo que queremos son unas infraestructuras que tengan el mantenimiento que merecen"
    },
    {
     "inicio": 35,
     "fin": 38.84,
     "texto": "el dinero que le han negado durante estos años y que ha llevado"
    },
    {
     "inicio": 38.84,
     "fin": 42.2,
     "texto": "a la tercera bundización del sistema ferroviario español."
    },
    {
     "inicio": 42.82,
     "fin": 46.58,
     "texto": "Luego, no queremos los planteamientos ni del señor Puente ni del señor Sánchez."
    },
    {
     "inicio": 46.68,
     "fin": 49.1,
     "texto": "Sabemos que ellos son los principales responsables"
    },
    {
     "inicio": 49.56,
     "fin": 53.08,
     "texto": "de que hayan muerto personas en Urda, de que hayan muerto personas en Adamuz"
    },
    {
     "inicio": 53.08,
     "fin": 57.34,
     "texto": "y de que hoy el sistema de alta velocidad español,"
    },
    {
     "inicio": 57.74,
     "fin": 63.04,
     "texto": "que era envidia del mundo, sea hoy el peor y el que más víctimas mortales"
    },
    {
     "inicio": 63.04,
     "fin": 64.56,
     "texto": "acumula de toda Europa."
    }
