   "frases": [
    {
     "inicio": 0,
     "fin": 4.2,
     "texto": "No hay una manera correcta de ser prácticamente res."
    },
    {
     "inicio": 5.3,
     "fin": 17.32,
     "texto": "Y yo digo claramente que si eres progresista, feminista, ecologista, si crees en la justicia social, en la democracia, en la libertad, en el antifacismo,"
    },
    {
     "inicio": 17.84,
     "fin": 23,
     "texto": "eres de los nuestros, no repartiendo carnets de absolutamente res."
    },
    {
     "inicio": 23,
     "fin": 36.01,
     "texto": "Pero de mano a memoria, quiza trancar la cara a Amnar, a Maguirre, a Mrajoi,"
    },
    {
     "inicio": 37.29,
     "fin": 46.31,
     "texto": "a todos los corruptas que han robado y que son los protagonistas dotado del patiment de la nuestra generación."
    },
    {
     "inicio": 46.31,
     "fin": 55.17,
     "texto": "Quiza es psicópata, Amazón. Quiza es inútil, Amazón. Quiza es homicida, imprudente, Amazón."
    },
    {
     "inicio": 56.25,
     "fin": 64.95,
     "texto": "Nosotras, ¿no? ¿Algú duda de que nos defensaremos? ¿Algú duda de que nos trencaremos la cara?"
    }
