   "frases": [
    {
     "inicio": 0,
     "fin": 2.62,
     "texto": "Lo que no puede ser es que todo aquello que pagan los españoles"
    },
    {
     "inicio": 2.62,
     "fin": 4.94,
     "texto": "sea para todos, porque hay recursos limitados."
    },
    {
     "inicio": 5.26,
     "fin": 7.74,
     "texto": "Y si hay recursos limitados, los recursos limitados son para los nuestros."
    },
    {
     "inicio": 8.3,
     "fin": 10.74,
     "texto": "Cuando estaba esperando en la urbanneta,"
    },
    {
     "inicio": 10.74,
     "fin": 14.14,
     "texto": "me han acercado una carta de una familia"
    },
    {
     "inicio": 14.66,
     "fin": 19.48,
     "texto": "contando de una situación de salud muy grave de una niña de Huésca,"
    },
    {
     "inicio": 19.72,
     "fin": 21.94,
     "texto": "se llama Sofía, con una enfermedad muy grave."
    },
    {
     "inicio": 22.64,
     "fin": 24.2,
     "texto": "Contándome las dificultades que tienen"
    },
    {
     "inicio": 24.2,
     "fin": 26.88,
     "texto": "como consecuencia del tratamiento y tener que desplazarse."
    },
    {
     "inicio": 27.3,
     "fin": 29.58,
     "texto": "¿Cómo es posible que haya una familia española"
    },
    {
     "inicio": 29.58,
     "fin": 32.84,
     "texto": "que esté con estas dificultades y no reciba ayuda pública"
    },
    {
     "inicio": 32.84,
     "fin": 35.18,
     "texto": "mientras estamos viendo todos los días hoy mismo"
    },
    {
     "inicio": 35.18,
     "fin": 38.66,
     "texto": "que se aprobaba una nueva partida de manutención"
    },
    {
     "inicio": 38.66,
     "fin": 41.32,
     "texto": "de todos los que han entrado ilegalmente en CEPTA?"
    },
    {
     "inicio": 41.52,
     "fin": 42.32,
     "texto": "¿Cómo es posible?"
    },
    {
     "inicio": 42.6,
     "fin": 45.36,
     "texto": "Ento esa carta venía esta cinta de la bandera del Pilar"
    },
    {
     "inicio": 45.36,
     "fin": 47.4,
     "texto": "con la bandera de Aragón y unas fotos de Sofía"
    },
    {
     "inicio": 47.4,
     "fin": 50.9,
     "texto": "que yo me llevo para mí y yo no me voy a olvidar de Sofía"
    },
    {
     "inicio": 50.9,
     "fin": 53.88,
     "texto": "en representación de los españoles que tienen dificultades"
    },
    {
     "inicio": 53.88,
     "fin": 56.54,
     "texto": "que trabajan y a veces, a pesar de que trabajan,"
    },
    {
     "inicio": 56.78,
     "fin": 58.32,
     "texto": "no pueden salir de la pobreza"
    },
    {
     "inicio": 58.32,
     "fin": 59.86,
     "texto": "o de una humildad muy grande"
    },
    {
     "inicio": 59.86,
     "fin": 62.68,
     "texto": "y que son los que, de verdad, necesitan ayuda."
    },
    {
     "inicio": 63.02,
     "fin": 64.34,
     "texto": "Eso es prioridad nacional."
    },
    {
     "inicio": 64.66,
     "fin": 66.4,
     "texto": "Eso es defender a tu propio pueblo."
    },
    {
     "inicio": 66.94,
     "fin": 69.16,
     "texto": "Yo tengo el compromiso de hacerlo."
    }
   ],
