       "texto": "nosotros debemos construir alianzas."
      },
      {
       "inicio": 36.02,
       "fin": 38.08,
       "texto": "Y frente a los que alimentan la guerra,"
      },
      {
       "inicio": 38.4,
       "fin": 41.14,
       "texto": "nosotros debemos ser sembradores de paz."
      }
