          "tipo": "titularAM",
          "texto": "ABASCAL: NO PUEDE ENTRAR NADIE MÁS EN ESPAÑA",
          "fecha": "20 NOV",
          "credito": "Vídeo: @vox_es"
        },
        {
          "tipo": "citas",
          "lineas": [
            {
              "inicio": 0.07,
              "fin": 2.4,
              "texto": "Porque pensamos que en estos momentos\nno puede entrar nadie más en España,"
            },
            {
              "inicio": 2.9,
              "fin": 5.9,
              "texto": "y queremos que tienen que salir\nlos que cometen delitos,"
            },
            {
              "inicio": 6.1,
              "fin": 8.4,
              "texto": "que tienen que irse a las cárceles\nde su país, sean legales o no,"
            },
            {
              "inicio": 8.9,
              "fin": 10.8,
              "texto": "tienen que salir los que han\nentrado ilegalmente"
            },
            {
              "inicio": 10.85,
              "fin": 13.15,
              "texto": "sin que haya ningún proceso\nde regularización,"
            },
            {
              "inicio": 13.4,
              "fin": 16.9,
              "texto": "porque creemos que es un mensaje\nde discriminación,"
            },
            {
              "inicio": 16.95,
              "fin": 18.9,
              "texto": "en primer lugar hacia los españoles\nque respetan la ley"
            },
            {
              "inicio": 18.95,
              "fin": 21.4,
              "texto": "y en segundo lugar hacia\nlos inmigrantes legales"
            },
            {
              "inicio": 21.45,
              "fin": 23.2,
              "texto": "que vinieron aquí también\nrespetando la ley"
            },
            {
              "inicio": 23.5,
              "fin": 25.9,
              "texto": "y en tercer lugar un proceso\nde remigración"
            },
            {
              "inicio": 25.95,
              "fin": 28.7,
              "texto": "de quienes hoy están en España\ny no están trabajando"
            },
            {
              "inicio": 28.75,
              "fin": 31.95,
              "texto": "sino viviendo de las ayudas sociales\nque hacen falta a los españoles."
            }
          ]
