     "lineas": [
      {
       "inicio": 0,
       "fin": 2.78,
       "texto": "Pero ha dicho una cosa que es verdad, ha dicho,"
      },
      {
       "inicio": 3.4,
       "fin": 4.94,
       "texto": "esta es la bandera de todos."
      },
      {
       "inicio": 6.52,
       "fin": 7.8,
       "texto": "Es la bandera de la democracia,"
      },
      {
       "inicio": 7.8,
       "fin": 9.12,
       "texto": "de la Constitución."
      },
      {
       "inicio": 9.22,
       "fin": 9.92,
       "texto": "Sí, sí, es la de todos."
      },
      {
       "inicio": 10.16,
       "fin": 12.78,
       "texto": "También es la de nuestra historia colectiva."
      },
      {
