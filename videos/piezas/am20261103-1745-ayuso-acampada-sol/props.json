            {
              "inicio": 0,
              "fin": 2.6,
              "texto": "Pedro Sánchez ha permitido otra vez"
            },
            {
              "inicio": 2.6,
              "fin": 5.14,
              "texto": "una situación ilegal que se ha producido"
            },
            {
