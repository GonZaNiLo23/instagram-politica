            },
            {
              "inicio": 7.44,
              "fin": 10.02,
              "texto": "Sánchez consintió por interés político"
            },
            {
              "inicio": 10.02,
              "fin": 12.14,
              "texto": "que se ocupara ilegalmente"
            },
            {
              "inicio": 12.14,
              "fin": 13.22,
              "texto": "la Puerta del Sol."
            },
            {
              "inicio": 13.22,
              "fin": 15.86,
              "texto": "Por tanto, es imperdonable que una vez más"
            },
            {
              "inicio": 15.86,
              "fin": 17.44,
              "texto": "Sánchez se haya permitido este daño"
            },
            {
              "inicio": 17.44,
