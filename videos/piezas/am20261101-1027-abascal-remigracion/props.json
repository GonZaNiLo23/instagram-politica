        },
        {
          "tipo": "citas",
          "lineas": [
            {
              "inicio": 0,
              "fin": 3.4,
              "texto": "Cuando hablamos de remigración nos\nreferimos"
            },
            {
              "inicio": 3.4,
              "fin": 6.1,
              "texto": "a las personas que, aun estando legalmente\nen España,"
            },
            {
              "inicio": 6.9,
              "fin": 10.16,
              "texto": "están viviendo de las ayudas sociales que\nhacen falta a los españoles."
            },
            {
              "inicio": 10.4,
              "fin": 13.6,
              "texto": "Cuando uno emigra a un país y tiene un\npermiso de trabajo,"
            },
            {
              "inicio": 14.42,
              "fin": 18.5,
              "texto": "cuando ese permiso de trabajo concluye, lo\nnormal es que se vayan del país"
            },
            {
              "inicio": 18.5,
              "fin": 20.26,
              "texto": "No es normal que vivan de las ayudas\nsociales."
            },
            {
              "inicio": 21.06,
              "fin": 25.24,
              "texto": "Eso demuestra la estafa de quienes nos\ndecían que venían a pagar las pensiones"
            },
            {
              "inicio": 25.24,
              "fin": 29.32,
              "texto": "y resulta que no pagan exactamente las\npensiones, sino que reciben ayudas\nsociales"
            },
            {
              "inicio": 29.32,
              "fin": 32.18,
              "texto": "que hacen falta a muchos españoles\nhumildes en estos momentos."
            }
          ]
        }
