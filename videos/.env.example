# Copia este archivo como videos/.env (NUNCA se sube a ningún sitio) y rellena los valores.

# Azure Speech (voz principal). Clave y región del recurso "Speech" en portal.azure.com
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# Opcional: voz (por defecto es-ES-AlvaroNeural) y velocidad (p. ej. +5%)
AZURE_SPEECH_VOICE=
AZURE_SPEECH_RATE=

# ElevenLabs (alternativa, no se usa si hay clave de Azure)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Opcional (por defecto eleven_multilingual_v2)
ELEVENLABS_MODEL=
